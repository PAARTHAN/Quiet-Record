# Database Configuration
# Template: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/deathnote_db

# Security Configuration
# Generate a secret key (e.g. openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
# Generate a Fernet key (e.g. cryptography.fernet.Fernet.generate_key().decode())
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Application Settings
TRIGGER_THRESHOLD_SECONDS=7776000
WARNING_THRESHOLD_SECONDS=5184000
AUTOTRIGGER_POLL_SECONDS=5

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_address_here
SMTP_PASSWORD=your_email_app_password_here
SMTP_FROM_EMAIL=your_email_address_here
SMTP_USE_TLS=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Twilio SMS Configuration
# Get these from your Twilio Console: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
